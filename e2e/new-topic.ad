context platform=ios kind=simulator

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000
press "label=\"Host Dev Host\""
wait "label=\"Host Options\"" 15000
wait 1500

wait "label=\"Host Options\"" 15000
# A Host Server serves Go to, so New Topic is in the ＋ menu of its bar. A
# debug build's warning toast lies over the bar and takes the tap.
react-native dismiss-overlay
press "label=\"New\""
wait "label=\"New Topic\"" 5000
is "visible" "role=button label=\"New Session at a folder\""
press "role=button label=\"New Topic\""
wait "label=\"Tag #work\"" 8000
fill "role=text-field" "e2e New Topic it's"
press "label=\"Tag #work\""
press "label=\"Create\""
# The same screen goes on to its folder step.
wait "text" "Add a Session" 15000
wait "label=\"Search folders\"" 15000
press "label=\"Add later\""
wait "label=\"Topic e2e New Topic it's\"" 15000
press "label=\"Topic e2e New Topic it's\""
wait "text" "Add a Session" 15000
wait "role=text-field" 15000
press "label=\"Cancel\""

close
