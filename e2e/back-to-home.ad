context platform=ios kind=simulator

open "dev.muxify.app" --relaunch
wait "label=\"Host Dev Host\"" 15000
is "absent" "label=\"Session 0\""
press "label=\"Host Dev Host\""
wait "label=\"Session 0\"" 15000
press "label=\"Session 0\""
wait "id=\"pane-command\"" 20000
is "text" "id=\"attached-session\"" "0"
# Back takes once the push onto the Terminal has ended.
wait 1500
back
wait "label=\"Host Options\"" 8000
is "absent" "label=\"Settings\""
press "label=\"Session 0\""
wait "id=\"pane-command\"" 3000
is "text" "id=\"attached-session\"" "0"
wait 1500
back
wait "label=\"Host Options\"" 8000
back
wait "label=\"Host Dev Host\"" 8000
is "visible" "label=\"Settings\""
close
