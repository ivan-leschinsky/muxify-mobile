context platform=ios kind=simulator

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000
press "label=\"Host Dev Host\""
wait "label=\"Host Options\"" 15000
wait 1500

wait "label=\"Topic e2e Edit Topic\"" 15000
press "label=\"Topic e2e Edit Topic\""
wait "id=\"pane-command\"" 20000
# The Header takes a press once the push onto the Topic Screen has ended.
wait 1500
press "label=\"Options\""
wait "label=\"Topic\" role=button" 8000
press "label=\"Topic\" role=button"
wait "label=\"Edit Topic…\" role=button" 8000
press "label=\"Edit Topic…\" role=button"
wait "label=\"Tag #e2eold\"" 15000
fill "label=\"Topic title\"" "e2e Edited it's"
# The Host Server takes a value that starts with -, which the Host CLI read as an option.
fill "label=\"Topic Note\" editable=true" "-x e2e second note"
press "label=\"Tag #e2eold\""
press "label=\"Tag #personal\""
press "label=\"Save\""
wait "id=\"pane-command\"" 15000
wait 1500
press "id=\"header-title\""
wait "label=\"Close Choose\"" 8000
wait "label=\"Note -x e2e second note\"" 15000
is "visible" "text=\"#personal  #work\""
press "label=\"Close Choose\""

close
