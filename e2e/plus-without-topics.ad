context platform=ios kind=simulator

# On a Host CLI that has no Go to, Options offers New Session. Run
# e2e/new-topic.sh, not this file: it runs this in the sandbox.

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000
press "label=\"Host Dev Host\""
wait "label=\"Host Options\"" 15000
# Home is still under the Host Screen until the push settles, and has the
# same Session and Topic rows.
wait 1500

press "label=\"Host Options\""
wait "label=\"New Session\"" 15000
press "role=button label=\"New Session\""
# Create belongs to the New Session sheet.
wait "label=\"Create\"" 8000

close
